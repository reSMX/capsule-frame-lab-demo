# Reference only: .env files are NOT loaded automatically.
# In PowerShell set variables before running .\start-web.ps1, for example:
# $env:DEVICE = 'cpu'
# $env:MODEL_PATH = 'C:\models\best.pt'

MODEL_PATH=runs/combined_galar_v1/best.pt
# REPORT_PATH defaults to report.json next to MODEL_PATH.
# REPORT_PATH=runs/combined_galar_v1/report.json
DEVICE=auto

VIDEO_SAMPLE_FPS=1
INFERENCE_BATCH_SIZE=16
MAX_PREVIEW_FRAMES=12

# Optional limits. Unset or 'unlimited' means no configured limit.
MAX_IMAGE_MB=unlimited
MAX_IMAGE_MEGAPIXELS=unlimited
MAX_VIDEO_MB=unlimited
MAX_VIDEO_SECONDS=unlimited
MAX_VIDEO_FRAMES=unlimited
